{
  "name": "unocss-preset-openchamber",
  "version": "0.1.0",
  "description": "OpenChamber 设计规范的 UnoCSS 预设：语义色板 + 三级抬起 + 一套量过的组件尺寸，4 套主题开箱可切",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "unocss",
    "unocss-preset",
    "design-system",
    "design-tokens",
    "openchamber"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/me9rez/unocss-preset-openchamber.git"
  },
  "homepage": "https://github.com/me9rez/openchamber-design-system",
  "files": [
    "dist",
    "themes",
    "NOTICE.md"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./themes/*.json": "./themes/*.json",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "scripts": {
    "gen": "node scripts/gen-themes.mjs",
    "build": "npm run gen && tsdown",
    "test": "npm run build && node --test test/",
    "prepack": "npm run build",
    "example": "npm run build && node scripts/build-example.mjs"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "@unocss/core": ">=0.65.0"
  },
  "devDependencies": {
    "@unocss/core": "^66.13.0",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2",
    "unocss": "^66.13.0"
  },
  "dependencies": {
    "@unocss/preset-wind4": "^66.13.0"
  }
}
